# Application contract. Inject these values using your own container deployment.
MONGODB_URI=mongodb://localhost:27017
TF_MONGO_DATABASE=tensorforge
REDIS_URL=redis://localhost:6379/0
TF_REDIS_NAMESPACE=tensorforge
TF_ADMIN_KEY=generate-64-random-hex-characters
TF_SERVICE_KEY=generate-another-64-random-hex-characters
TF_AI_URL=http://ai:8101
TF_ADDR=:8000
TF_WEB_DIR=web
TF_CONCURRENCY=1
TF_QUEUE_SIZE=8
TF_SECURE_COOKIES=false
TF_WRITE_APPROVAL=true
TF_DATA_DIR=/data
HF_HOME=/data/huggingface
TF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TF_EMBEDDING_REVISION=
TF_VLLM_START_TIMEOUT=300
